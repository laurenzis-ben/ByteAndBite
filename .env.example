# OpenAI API Key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# PostgreSQL Verbindung
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/byteandbite

# USDA FoodData Central API Key
# Kostenlosen Key registrieren: https://api.data.gov/signup/
# Ohne Key funktioniert DEMO_KEY (30 req/h, 50/Tag)
FDC_API_KEY=DEMO_KEY
